// The screens.
//
// Each is a pure function of its inputs: it receives already-formatted data and emits
// intents as callbacks. No screen performs I/O, computes a percentage, or decides what
// an absent value looks like.

import { ScrollView, LineEdit, TextEdit, ComboBox, CheckBox } from "std-widgets.slint";
import { Theme, Layout } from "theme.slint";
import { L } from "strings.slint";
import {
    Card, Chart, DetailRow, EmptyState, FlatButton, FormRow, MeterBar, SegmentedControl,
    StatusBadge, TabStrip, TileGrid
} from "components.slint";
import {
    AlertRow, ChartData, ContainerRow, EventRow, FileEntry, ProcessRow, ServerDetail,
    ServerRow, ServiceRow, SiteFolder, StatCard, TopPageRow, WebsiteCard, WebsiteDetail
} from "models.slint";

// --- Shared ------------------------------------------------------------------------

// The card grid, shared by the dashboard, the websites screen and the server detail.
export component WebsiteGrid inherits VerticalLayout {
    in property <[WebsiteCard]> websites;
    out property <string> last-opened;
    callback open();

    spacing: Theme.space-md;

    // Slint has no wrapping flow layout, so the grid is laid out by hand: rows of
    // `Layout.grid-columns` cards. That is also what makes the single-column mobile case
    // fall out for free.
    for row-index in ceil(root.websites.length / Layout.grid-columns): HorizontalLayout {
        spacing: Theme.space-md;

        for column in Layout.grid-columns: cell := Rectangle {
            // Elements are named so descendants can reach the cell's data directly:
            // walking up with `parent.parent` is not something Slint supports.
            property <int> index: row-index * Layout.grid-columns + column;
            property <bool> present: self.index < root.websites.length;
            property <WebsiteCard> card:
                root.websites[min(self.index, max(0, root.websites.length - 1))];

            horizontal-stretch: 1;
            background: self.present ? Theme.surface : transparent;
            border-radius: Theme.radius;
            border-width: self.present ? 1px : 0;
            border-color: preview-touch.has-hover ? Theme.accent : Theme.border;
            height: self.present ? 232px : 0;
            clip: true;

            if cell.present: VerticalLayout {
                // Preview.
                Rectangle {
                    height: 118px;
                    background: Theme.surface-raised;
                    clip: true;

                    if cell.card.has-thumbnail: Image {
                        source: cell.card.thumbnail;
                        width: parent.width;
                        image-fit: cover;
                        vertical-alignment: top;
                    }
                    if !cell.card.has-thumbnail: Text {
                        text: cell.card.preview-message;
                        font-size: Theme.text-xs;
                        color: Theme.text-faint;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        width: parent.width - 2 * Theme.space-md;
                    }
                }

                VerticalLayout {
                    padding: Theme.space-md;
                    spacing: 3px;

                    HorizontalLayout {
                        Text {
                            text: cell.card.name;
                            font-size: Theme.text-sm;
                            font-weight: 700;
                            color: Theme.text;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        StatusBadge {
                            status: cell.card.status;
                            compact: true;
                            width: 12px;
                        }
                    }

                    Text {
                        text: cell.card.visitors;
                        font-size: Theme.text-xs;
                        color: Theme.text-muted;
                    }
                    Text {
                        text: cell.card.response;
                        font-size: Theme.text-xs;
                        color: Theme.text-muted;
                    }
                    Text {
                        text: cell.card.ssl;
                        font-size: Theme.text-xs;
                        color: Theme.text-muted;
                    }
                    // The capture age travels with the image, always. A cached preview
                    // shown without its age is the failure this whole feature guards
                    // against.
                    Text {
                        text: cell.card.capture-age;
                        font-size: Theme.text-xs;
                        color: Theme.text-faint;
                    }
                }
            }

            preview-touch := TouchArea {
                enabled: cell.present;
                mouse-cursor: pointer;
                clicked => {
                    root.last-opened = cell.card.id;
                    root.open();
                }
            }
        }
    }
}

// --- Dashboard ---------------------------------------------------------------------

export component DashboardScreen inherits ScrollView {
    // Never wider than the window.
    //
    // A `ScrollView` gives its content the content's own preferred width, and a `Text`
    // set to wrap still reports the width it would need on one line. So a single long
    // sentence made the whole page as wide as that sentence, and every card on it was
    // cut off at the same vertical line — which is what "nothing is adapted" actually
    // looked like. Pinning the viewport to the visible width makes the text wrap
    // instead.
    viewport-width: root.visible-width;

    in property <[StatCard]> infrastructure-cards;
    in property <[StatCard]> traffic-cards;
    in property <ChartData> visitors-chart;
    in property <ChartData> cpu-chart;
    in property <[ServerRow]> problem-servers;
    in property <[AlertRow]> recent-alerts;
    in property <[EventRow]> recent-events;
    in property <[WebsiteCard]> website-previews;
    in property <bool> has-analytics;
    in property <bool> is-empty;

    callback open-server(string);
    callback open-website(string);
    callback add-server();

    VerticalLayout {
        padding: Layout.page-padding;
        spacing: Theme.space-lg;

        if root.is-empty: EmptyState {
            title: L.dash_nothing_monitored;
            detail: L.dash_nothing_monitored_detail;
            action-text: L.servers_add_a;
            action => { root.add-server(); }
        }

        if !root.is-empty: VerticalLayout {
            spacing: Theme.space-lg;

            // Infrastructure at a glance.
            TileGrid { cards: root.infrastructure-cards; }

            // Traffic, only when a provider is configured — an empty traffic row would
            // be indistinguishable from a site with no visitors.
            if root.has-analytics: TileGrid { cards: root.traffic-cards; }

            // Charts side by side on a wide screen, stacked on a narrow one.
            if !Layout.compact: HorizontalLayout {
                spacing: Theme.space-md;
                if root.has-analytics: Chart {
                    data: root.visitors-chart;
                    horizontal-stretch: 1;
                }
                Chart {
                    data: root.cpu-chart;
                    horizontal-stretch: 1;
                }
            }
            if Layout.compact: VerticalLayout {
                spacing: Theme.space-md;
                if root.has-analytics: Chart { data: root.visitors-chart; }
                Chart { data: root.cpu-chart; }
            }

            // Problems first: this is the panel a user opens the app to read.
            if root.problem-servers.length > 0: Card {
                title: L.dash_needs_attention;
                subtitle: L.dash_problem_servers;

                for server in root.problem-servers: Rectangle {
                    height: 46px;
                    background: row-touch.has-hover ? Theme.surface-hover : transparent;
                    border-radius: Theme.radius-sm;

                    HorizontalLayout {
                        padding-left: Theme.space-sm;
                        padding-right: Theme.space-sm;
                        spacing: Theme.space-md;

                        // The badge becomes a dot on a phone. The colour carries the
                        // meaning; the word beside it costs 90px that the server's name
                        // needs more.
                        StatusBadge {
                            status: server.status;
                            label: server.status-label;
                            compact: Layout.phone;
                            width: Layout.phone ? 14px : 96px;
                        }
                        Text {
                            text: server.name;
                            font-size: Theme.text-sm;
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            min-width: Layout.phone ? 0px : 180px;
                            max-width: Layout.phone ? 100000px : 180px;
                            overflow: elide;
                        }
                        Text {
                            text: server.last-check;
                            font-size: Theme.text-sm;
                            color: Theme.text-faint;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }

                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-server(server.id); }
                    }
                }
            }

            if !Layout.compact: HorizontalLayout {
                spacing: Theme.space-md;

                Card {
                    title: L.dash_recent_alerts;
                    horizontal-stretch: 1;

                    if root.recent-alerts.length == 0: Text {
                        text: L.dash_no_alerts;
                        font-size: Theme.text-sm;
                        color: Theme.text-faint;
                    }
                    for alert in root.recent-alerts: HorizontalLayout {
                        spacing: Theme.space-sm;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        StatusBadge { status: alert.severity; compact: true; width: 12px; }
                        VerticalLayout {
                            Text {
                                text: alert.title;
                                font-size: Theme.text-sm;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                text: alert.opened;
                                font-size: Theme.text-xs;
                                color: Theme.text-faint;
                            }
                        }
                    }
                }

                Card {
                    title: L.dash_recent_events;
                    horizontal-stretch: 1;

                    if root.recent-events.length == 0: Text {
                        text: L.dash_nothing_happened;
                        font-size: Theme.text-sm;
                        color: Theme.text-faint;
                    }
                    for event in root.recent-events: HorizontalLayout {
                        spacing: Theme.space-sm;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        StatusBadge { status: event.severity; compact: true; width: 12px; }
                        Text {
                            text: event.message;
                            font-size: Theme.text-sm;
                            color: Theme.text-muted;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: event.when;
                            font-size: Theme.text-xs;
                            color: Theme.text-faint;
                        }
                    }
                }
            }

            // Website previews last: the heaviest thing on the page, so it loads while
            // the numbers above are already readable.
            if root.website-previews.length > 0: Card {
                title: L.nav_websites;
                WebsiteGrid {
                    websites: root.website-previews;
                    open => { root.open-website(self.last-opened); }
                }
            }
        }
    }
}

// --- Servers -----------------------------------------------------------------------

export component ServersScreen inherits VerticalLayout {
    in property <[ServerRow]> servers;
    in-out property <string> filter;

    callback open(string);
    callback add();
    callback refresh(string);

    padding: Layout.page-padding;
    spacing: Theme.space-md;

    // On a phone the search box takes a row of its own. Title, search and button on one
    // line leaves all three too narrow: the button loses its label and the search box
    // shows about one word.
    VerticalLayout {
        spacing: Theme.space-sm;
        // A nested layout stretches by default, and this one holds a title and a
        // single-line search box: without this the search box grew to fill the screen.
        vertical-stretch: 0;

        HorizontalLayout {
            spacing: Theme.space-sm;

            Text {
                text: L.nav_servers;
                font-size: Theme.text-lg;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if !Layout.phone: LineEdit {
                placeholder-text: L.servers_filter;
                width: Layout.compact ? 160px : 260px;
                text <=> root.filter;
            }
            FlatButton {
                text: L.servers_add;
                primary: true;
                clicked => { root.add(); }
            }
        }

        if Layout.phone: LineEdit {
            placeholder-text: L.servers_filter;
            text <=> root.filter;
            // An explicit height because neither `vertical-stretch: 0` on this row nor
            // on the box itself stopped it growing to fill the screen. Measured on a
            // 391px window rather than reasoned about, which is why the number is here
            // and not a theory about who stretches.
            height: 32px;
        }
    }

    if root.servers.length == 0: EmptyState {
        title: L.servers_empty;
        detail: L.servers_empty_detail;
        action-text: L.servers_add_a;
        action => { root.add(); }
    }

    if root.servers.length > 0: ScrollView {
        // Vertical only: see the note on the screens above.
        viewport-width: self.visible-width;
        VerticalLayout {
            spacing: Theme.space-sm;

            for server in root.servers: Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: card-touch.has-hover ? Theme.accent : Theme.border;
                min-height: Layout.compact ? 140px : 84px;

                VerticalLayout {
                    padding: Layout.card-padding;
                    spacing: Theme.space-sm;

                    HorizontalLayout {
                        spacing: Theme.space-sm;

                        // `min-width`/`max-width` rather than `width`, because a phone
                        // has to give this column whatever is left after the badge and
                        // a fixed width cannot know what that is. The two are equal on
                        // a desktop, which is the same thing a fixed width said.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: Layout.phone ? 90px : (Layout.compact ? 140px : 220px);
                            max-width: Layout.phone ? 100000px : (Layout.compact ? 140px : 220px);
                            spacing: 2px;
                            Text {
                                text: server.name;
                                font-size: Theme.text-base;
                                font-weight: 600;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                text: server.host;
                                font-size: Theme.text-xs;
                                color: Theme.text-faint;
                                overflow: elide;
                            }
                            // The column that would have carried this is gone on a
                            // phone, and "when was this last checked" is the first
                            // question a stale-looking number raises.
                            if Layout.phone: Text {
                                text: server.last-check;
                                font-size: Theme.text-xs;
                                color: Theme.text-faint;
                                overflow: elide;
                            }
                        }

                        StatusBadge {
                            status: server.status;
                            label: server.status-label;
                            width: Layout.phone ? 84px : 92px;
                        }

                        // The spacer exists to push the right-hand columns to the edge.
                        // Where there are no right-hand columns it would only steal
                        // width from the name.
                        Rectangle { horizontal-stretch: Layout.phone ? 0 : 1; }

                        if !Layout.compact: VerticalLayout {
                            width: 110px;
                            alignment: center;
                            Text {
                                text: L.label_uptime;
                                font-size: Theme.text-xs;
                                color: Theme.text-faint;
                            }
                            Text {
                                text: server.uptime;
                                font-size: Theme.text-sm;
                                color: Theme.text;
                            }
                        }

                        if !Layout.phone: VerticalLayout {
                            width: 110px;
                            alignment: center;
                            Text {
                                text: L.label_last_check;
                                font-size: Theme.text-xs;
                                color: Theme.text-faint;
                            }
                            Text {
                                text: server.last-check;
                                font-size: Theme.text-sm;
                                color: Theme.text-muted;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Layout.phone ? Theme.space-sm : Theme.space-lg;
                        MeterBar {
                            label: L.label_cpu;
                            value: server.cpu;
                            fraction: server.cpu-fraction;
                            horizontal-stretch: 1;
                        }
                        MeterBar {
                            label: L.label_ram;
                            value: server.ram;
                            fraction: server.ram-fraction;
                            horizontal-stretch: 1;
                        }
                        MeterBar {
                            label: L.label_disk;
                            value: server.disk;
                            fraction: server.disk-fraction;
                            horizontal-stretch: 1;
                        }
                    }
                }

                card-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open(server.id); }
                }
            }
        }
    }
}

// --- Server details ----------------------------------------------------------------

export component ServerDetailScreen inherits VerticalLayout {
    in property <ServerDetail> server;
    in property <[ChartData]> charts;
    in property <[ProcessRow]> processes;
    in property <[ContainerRow]> containers;
    in property <[ServiceRow]> services;
    in property <[EventRow]> events;
    in property <[WebsiteCard]> websites;
    in property <[string]> ranges;
    in-out property <int> tab: 0;
    in-out property <int> range: 2;

    callback back();
    callback range-changed(int);
    callback refresh();
    callback open-website(string);
    callback forget-host-key();
    callback delete-server();
    callback edit-server();
    callback open-files();

    // Two-step, because both actions on the Settings tab are irreversible and neither
    // has an undo. Which one is armed is tracked here rather than in a modal: a
    // confirmation the user has to read is better than one they dismiss by reflex.
    property <bool> confirming-forget: false;
    property <bool> confirming-delete: false;

    property <[string]> tabs: [
        L.tab_overview, L.tab_metrics, L.tab_processes, L.tab_services, L.tab_docker, L.nav_websites, L.tab_events,
        L.nav_settings
    ];

    padding: Layout.page-padding;
    spacing: Theme.space-md;

    HorizontalLayout {
        spacing: Theme.space-sm;

        FlatButton {
            text: L.action_back;
            clicked => { root.back(); }
        }
        VerticalLayout {
            spacing: 1px;
            Text {
                text: root.server.name;
                font-size: Theme.text-lg;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: root.server.host;
                font-size: Theme.text-xs;
                color: Theme.text-faint;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        StatusBadge { status: root.server.status; label: root.server.status-label; }
        FlatButton {
            text: L.nav_files;
            clicked => { root.open-files(); }
        }
        FlatButton {
            text: L.action_refresh;
            clicked => { root.refresh(); }
        }
    }

    if root.server.last-error != "": Rectangle {
        background: Theme.status-critical.with-alpha(0.12);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.status-critical.with-alpha(0.4);
        VerticalLayout {
            padding: Theme.space-sm;
            spacing: 2px;

            Text {
                text: root.server.last-error;
                font-size: Theme.text-sm;
                color: Theme.status-critical;
                wrap: word-wrap;
            }

            // The transport's own words. Kept, and kept quiet: the sentence above says
            // what to do, this says exactly what happened.
            if root.server.last-error-detail != root.server.last-error: Text {
                text: root.server.last-error-detail;
                font-size: Theme.text-xs;
                color: Theme.text-faint;
                wrap: word-wrap;
            }
        }
    }

    // Why the status is what it is. A colour on its own sends a person hunting through
    // eight tabs; this names the measurement and offers to open its chart.
    if root.server.status-reason != "": Rectangle {
        background: (root.server.status == "critical"
            ? Theme.status-critical
            : Theme.status-warning).with-alpha(0.12);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: (root.server.status == "critical"
            ? Theme.status-critical
            : Theme.status-warning).with-alpha(0.4);

        HorizontalLayout {
            padding: Theme.space-sm;
            spacing: Theme.space-sm;

            Text {
                text: root.server.status-reason;
                font-size: Theme.text-sm;
                color: root.server.status == "critical"
                    ? Theme.status-critical
                    : Theme.status-warning;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }

            if root.server.status-reason-has-chart: FlatButton {
                text: L.sd_show_on_chart;
                // The Metrics tab, where every measurement has a chart. Jumping there is
                // the difference between naming a problem and finding it.
                clicked => { root.tab = 1; }
            }
        }
    }

    TabStrip {
        options: root.tabs;
        selected <=> root.tab;
    }

    ScrollView {
        // Vertical only: see the note on the screens above.
        viewport-width: self.visible-width;
        VerticalLayout {
            spacing: Theme.space-md;

            // Overview.
            if root.tab == 0: VerticalLayout {
                spacing: Theme.space-md;

                TileGrid { cards: root.server.cards; }

                Card {
                    title: L.sd_system;
                    DetailRow { label: L.sd_operating_system; value: root.server.os; }
                    DetailRow { label: L.sd_kernel; value: root.server.kernel; }
                    DetailRow { label: L.sd_architecture; value: root.server.architecture; }
                    DetailRow { label: L.label_cpu; value: root.server.cpu-model; }
                    DetailRow { label: L.sd_cores; value: root.server.cores; }
                    DetailRow { label: L.label_uptime; value: root.server.uptime; }
                    DetailRow { label: L.label_last_check; value: root.server.last-check; }
                }
            }

            // Metrics.
            if root.tab == 1: VerticalLayout {
                spacing: Theme.space-md;

                HorizontalLayout {
                    alignment: end;
                    SegmentedControl {
                        options: root.ranges;
                        selected <=> root.range;
                        changed(index) => { root.range-changed(index); }
                    }
                }
                for chart in root.charts: Chart { data: chart; }
            }

            // Processes.
            if root.tab == 2: Card {
                title: L.sd_top_processes;
                subtitle: L.sd_sorted_by_cpu;

                if root.processes.length == 0: Text {
                    text: L.sd_no_processes;
                    font-size: Theme.text-sm;
                    color: Theme.text-faint;
                }
                // Five columns need about 450px and a phone has 310, so the row becomes
                // two lines: what is running and what it costs on the first, the
                // identifying detail on the second. Nothing is dropped — a process table
                // that hides the owner is one you cannot act on.
                for process in root.processes: VerticalLayout {
                    padding-top: 3px;
                    padding-bottom: 3px;
                    spacing: 1px;

                    HorizontalLayout {
                        spacing: Theme.space-md;

                        if !Layout.phone: Text { text: process.pid; font-size: Theme.text-xs; color: Theme.text-faint; width: 60px; }
                        if !Layout.phone: Text { text: process.user; font-size: Theme.text-xs; color: Theme.text-muted; width: 90px; overflow: elide; }
                        Text { text: process.command; font-size: Theme.text-sm; color: Theme.text; horizontal-stretch: 1; overflow: elide; }
                        Text { text: process.cpu; font-size: Theme.text-sm; color: Theme.text-muted; width: 64px; horizontal-alignment: right; }
                        if !Layout.phone: Text { text: process.memory; font-size: Theme.text-sm; color: Theme.text-muted; width: 64px; horizontal-alignment: right; }
                    }

                    if Layout.phone: HorizontalLayout {
                        spacing: Theme.space-sm;

                        Text { text: process.pid; font-size: Theme.text-xs; color: Theme.text-faint; }
                        Text { text: process.user; font-size: Theme.text-xs; color: Theme.text-muted; horizontal-stretch: 1; overflow: elide; }
                        Text { text: process.memory; font-size: Theme.text-xs; color: Theme.text-muted; }
                    }
                }
            }

            // Services. Hidden entirely on a host without systemd rather than shown empty.
            if root.tab == 3: VerticalLayout {
                if !root.server.has-systemd: EmptyState {
                    title: L.sd_no_systemd;
                    detail: L.sd_no_systemd_detail;
                }
                if root.server.has-systemd: Card {
                    title: L.tab_services;
                    for service in root.services: HorizontalLayout {
                        spacing: Theme.space-md;
                        padding-top: 3px;
                        padding-bottom: 3px;

                        StatusBadge {
                            status: service.state;
                            label: service.state-label;
                            compact: Layout.phone;
                            width: Layout.phone ? 14px : 100px;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: Layout.phone ? 0px : 200px;
                            max-width: Layout.phone ? 100000px : 200px;
                            spacing: 1px;

                            Text { text: service.name; font-size: Theme.text-sm; color: Theme.text; overflow: elide; }
                            // Under the name rather than beside it: side by side, each
                            // would get half of nothing.
                            if Layout.phone: Text { text: service.description; font-size: Theme.text-xs; color: Theme.text-faint; overflow: elide; }
                        }
                        if !Layout.phone: Text { text: service.description; font-size: Theme.text-xs; color: Theme.text-faint; horizontal-stretch: 1; overflow: elide; }
                    }
                }
            }

            // Docker.
            if root.tab == 4: VerticalLayout {
                if !root.server.has-docker: EmptyState {
                    title: L.sd_no_docker;
                    detail: L.sd_no_docker_detail;
                }
                if root.server.has-docker: Card {
                    title: L.sd_containers;
                    if root.containers.length == 0: Text {
                        text: L.sd_docker_empty;
                        font-size: Theme.text-sm;
                        color: Theme.text-faint;
                    }
                    for container in root.containers: VerticalLayout {
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 1px;

                        HorizontalLayout {
                            spacing: Theme.space-md;

                            StatusBadge { status: container.status; label: ""; compact: true; width: 12px; }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                min-width: Layout.phone ? 0px : 180px;
                                max-width: Layout.phone ? 100000px : 180px;
                                Text { text: container.name; font-size: Theme.text-sm; font-weight: 600; color: Theme.text; overflow: elide; }
                                Text { text: container.image; font-size: Theme.text-xs; color: Theme.text-faint; overflow: elide; }
                            }
                            if !Layout.phone: Text { text: container.status-text; font-size: Theme.text-xs; color: Theme.text-muted; horizontal-stretch: 1; overflow: elide; }
                            if !Layout.phone: Text { text: container.cpu; font-size: Theme.text-sm; color: Theme.text-muted; width: 64px; horizontal-alignment: right; }
                            if !Layout.phone: Text { text: container.memory; font-size: Theme.text-sm; color: Theme.text-muted; width: 90px; horizontal-alignment: right; }
                            if !Layout.phone: Text { text: container.restarts; font-size: Theme.text-xs; color: Theme.text-faint; width: 70px; horizontal-alignment: right; }
                        }

                        // Six columns do not fit a phone, and a container's numbers are
                        // the reason to open this tab, so they take a second line rather
                        // than disappearing.
                        if Layout.phone: HorizontalLayout {
                            spacing: Theme.space-sm;
                            padding-left: 12px + Theme.space-md;

                            Text { text: container.status-text; font-size: Theme.text-xs; color: Theme.text-muted; horizontal-stretch: 1; overflow: elide; }
                            Text { text: container.cpu; font-size: Theme.text-xs; color: Theme.text-muted; }
                            Text { text: container.memory; font-size: Theme.text-xs; color: Theme.text-muted; }
                            Text { text: container.restarts; font-size: Theme.text-xs; color: Theme.text-faint; }
                        }
                    }
                }
            }

            // Websites hosted here.
            if root.tab == 5: VerticalLayout {
                if root.websites.length == 0: EmptyState {
                    title: L.sd_no_websites;
                    detail: L.sd_no_websites_detail;
                }
                if root.websites.length > 0: WebsiteGrid {
                    websites: root.websites;
                    open => { root.open-website(self.last-opened); }
                }
            }

            // Events.
            if root.tab == 7: VerticalLayout {
                spacing: Theme.space-md;

                Card {
                    title: L.sd_connection;

                    DetailRow { label: L.label_address; value: root.server.host; }
                    DetailRow { label: L.label_status; value: root.server.status-label; }
                    DetailRow { label: L.label_last_check; value: root.server.last-check; }
                }

                Card {
            title: L.servers_edit;

            Text {
                text: L.dlg_ssh_subtitle;
                font-size: Theme.text-sm;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: start;
                FlatButton {
                    text: L.action_edit;
                    clicked => { root.edit-server(); }
                }
            }
        }

        Card {
                    title: L.sd_host_key;

                    Text {
                        text: L.sd_host_key_detail;
                        font-size: Theme.text-sm;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    Text {
                        text: L.sd_host_key_warning;
                        font-size: Theme.text-xs;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-sm;
                        padding-top: Theme.space-sm;

                        if !root.confirming-forget: FlatButton {
                            text: L.sd_forget_host_key;
                            clicked => { root.confirming-forget = true; }
                        }
                        if root.confirming-forget: Text {
                            text: L.sd_forget_confirm;
                            font-size: Theme.text-sm;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        if root.confirming-forget: FlatButton {
                            text: L.action_cancel;
                            clicked => { root.confirming-forget = false; }
                        }
                        if root.confirming-forget: FlatButton {
                            text: L.sd_forget_it;
                            primary: true;
                            clicked => {
                                root.confirming-forget = false;
                                root.forget-host-key();
                            }
                        }
                    }
                }

                Card {
                    title: L.action_remove;

                    Text {
                        text: L.sd_remove_detail;
                        font-size: Theme.text-sm;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-sm;
                        padding-top: Theme.space-sm;

                        if !root.confirming-delete: FlatButton {
                            text: L.sd_remove_server;
                            clicked => { root.confirming-delete = true; }
                        }
                        if root.confirming-delete: Text {
                            text: L.sd_remove_confirm_prefix + root.server.name + L.sd_remove_confirm_suffix;
                            font-size: Theme.text-sm;
                            color: Theme.status-critical;
                            vertical-alignment: center;
                        }
                        if root.confirming-delete: FlatButton {
                            text: L.action_cancel;
                            clicked => { root.confirming-delete = false; }
                        }
                        if root.confirming-delete: FlatButton {
                            text: L.action_remove;
                            primary: true;
                            clicked => {
                                root.confirming-delete = false;
                                root.delete-server();
                            }
                        }
                    }
                }
            }

            if root.tab == 6: Card {
                title: L.tab_events;
                if root.events.length == 0: Text {
                    text: L.sd_no_events;
                    font-size: Theme.text-sm;
                    color: Theme.text-faint;
                }
                for event in root.events: HorizontalLayout {
                    spacing: Theme.space-sm;
                    padding-top: 4px;
                    padding-bottom: 4px;

                    StatusBadge { status: event.severity; compact: true; width: 12px; }
                    Text { text: event.message; font-size: Theme.text-sm; color: Theme.text; horizontal-stretch: 1; overflow: elide; }
                    Text { text: event.when; font-size: Theme.text-xs; color: Theme.text-faint; }
                }
            }
        }
    }
}

// --- Websites ----------------------------------------------------------------------



export component WebsitesScreen inherits VerticalLayout {
    in property <[WebsiteCard]> websites;
    in-out property <bool> grid-view: true;

    callback open(string);
    callback add();

    padding: Layout.page-padding;
    spacing: Theme.space-md;

    HorizontalLayout {
        spacing: Theme.space-sm;
        Text {
            text: L.nav_websites;
            font-size: Theme.text-lg;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if !Layout.compact: SegmentedControl {
            options: [L.websites_grid, L.websites_list];
            selected: root.grid-view ? 0 : 1;
            changed(index) => { root.grid-view = index == 0; }
        }
        FlatButton {
            text: L.websites_add;
            primary: true;
            clicked => { root.add(); }
        }
    }

    if root.websites.length == 0: EmptyState {
        title: L.websites_empty;
        detail: L.websites_empty_detail;
        action-text: L.websites_add_a;
        action => { root.add(); }
    }

    if root.websites.length > 0: ScrollView {
        // Vertical only: see the note on the screens above.
        viewport-width: self.visible-width;
        VerticalLayout {
            spacing: Theme.space-sm;

            if root.grid-view && !Layout.compact: WebsiteGrid {
                websites: root.websites;
                open => { root.open(self.last-opened); }
            }
            if Layout.compact: WebsiteGrid {
                websites: root.websites;
                open => { root.open(self.last-opened); }
            }

            if !root.grid-view && !Layout.compact: VerticalLayout {
                spacing: 2px;
                for website in root.websites: Rectangle {
                    height: 52px;
                    background: list-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-radius: Theme.radius-sm;

                    HorizontalLayout {
                        padding: Theme.space-sm;
                        spacing: Theme.space-md;

                        StatusBadge { status: website.status; label: website.status-label; width: 96px; }
                        VerticalLayout {
                            width: 240px;
                            Text { text: website.name; font-size: Theme.text-sm; font-weight: 600; color: Theme.text; overflow: elide; }
                            Text { text: website.url; font-size: Theme.text-xs; color: Theme.text-faint; overflow: elide; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: website.response; font-size: Theme.text-sm; color: Theme.text-muted; width: 120px; vertical-alignment: center; }
                        Text { text: website.ssl; font-size: Theme.text-sm; color: Theme.text-muted; width: 150px; vertical-alignment: center; }
                        Text { text: website.uptime; font-size: Theme.text-sm; color: Theme.text-muted; width: 100px; vertical-alignment: center; }
                    }

                    list-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open(website.id); }
                    }
                }
            }
        }
    }
}

// --- Website details ---------------------------------------------------------------

export component WebsiteDetailScreen inherits VerticalLayout {
    in property <WebsiteDetail> website;
    in property <[ChartData]> charts;
    in property <[TopPageRow]> top-pages;
    in property <[EventRow]> events;
    in property <[string]> periods;
    in-out property <int> tab: 0;
    in-out property <int> period: 2;
    /// The counter this website is connected to, empty when it is not.
    in property <string> analytics-counter;
    /// Whether the shared OAuth token has been saved. Without it a counter cannot be
    /// read, so the form says so rather than accepting a number that will not work.
    in property <bool> analytics-token-saved;
    in property <string> analytics-error;

    callback back();
    callback period-changed(int);
    callback refresh-screenshot();
    callback edit-website();
    callback connect-analytics(string);
    callback disconnect-analytics();

    property <[string]> tabs: [L.tab_overview, L.nav_analytics, L.tab_availability, L.tab_ssl, L.tab_events];

    padding: Layout.page-padding;
    spacing: Theme.space-md;

    HorizontalLayout {
        spacing: Theme.space-sm;
        FlatButton {
            text: L.action_back;
            clicked => { root.back(); }
        }
        VerticalLayout {
            spacing: 1px;
            Text { text: root.website.name; font-size: Theme.text-lg; font-weight: 700; color: Theme.text; }
            Text { text: root.website.url; font-size: Theme.text-xs; color: Theme.text-faint; }
        }
        Rectangle { horizontal-stretch: 1; }
        FlatButton {
            text: L.action_edit;
            clicked => { root.edit-website(); }
        }
        StatusBadge { status: root.website.status; label: root.website.status-label; }
    }

    TabStrip {
        options: root.tabs;
        selected <=> root.tab;
    }

    ScrollView {
        // Vertical only: see the note on the screens above.
        viewport-width: self.visible-width;
        VerticalLayout {
            spacing: Theme.space-md;

            // Overview.
            if root.tab == 0: VerticalLayout {
                spacing: Theme.space-md;

                TileGrid { cards: root.website.cards; }

                Card {
                    title: L.dash_preview;
                    subtitle: root.website.capture-age;

                    Rectangle {
                        height: 300px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-sm;
                        clip: true;

                        if root.website.has-thumbnail: Image {
                            source: root.website.thumbnail;
                            width: parent.width;
                            image-fit: contain;
                        }
                        if !root.website.has-thumbnail: VerticalLayout {
                            alignment: center;
                            spacing: Theme.space-sm;
                            Text {
                                text: root.website.preview-message;
                                font-size: Theme.text-sm;
                                color: Theme.text-faint;
                                horizontal-alignment: center;
                            }
                            HorizontalLayout {
                                alignment: center;
                                FlatButton {
                                    text: L.action_retry;
                                    clicked => { root.refresh-screenshot(); }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        FlatButton {
                            text: L.wd_refresh_screenshot;
                            clicked => { root.refresh-screenshot(); }
                        }
                    }
                }
            }

            // Analytics.
            if root.tab == 1: VerticalLayout {
                spacing: Theme.space-md;

                // Not connected: offer to connect it here rather than sending the user
                // to a settings screen that cannot know which website they meant.
                if !root.website.has-analytics: Card {
                    title: L.wd_connect_analytics;
                    subtitle: root.analytics-token-saved
                        ? L.wd_counter_hint
                        : L.err_no_analytics_token;

                    FormRow {
                        label: L.set_counter_id;

                        counter-input := LineEdit {
                            placeholder-text: "54028423";
                            enabled: root.analytics-token-saved;
                            horizontal-stretch: 1;
                            accepted => { root.connect-analytics(self.text); }
                        }

                        FlatButton {
                            text: L.action_connect;
                            primary: true;
                            enabled: root.analytics-token-saved;
                            clicked => { root.connect-analytics(counter-input.text); }
                        }
                    }

                    if root.analytics-error != "": Text {
                        text: root.analytics-error;
                        font-size: Theme.text-sm;
                        color: Theme.status-critical;
                        wrap: word-wrap;
                    }
                }

                if root.website.has-analytics: VerticalLayout {
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        Text {
                            text: root.website.analytics-updated;
                            font-size: Theme.text-xs;
                            color: Theme.text-faint;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        SegmentedControl {
                            options: root.periods;
                            selected <=> root.period;
                            changed(index) => { root.period-changed(index); }
                        }
                    }

                    // Which counter these figures come from, and a way out. Without
                    // this a wrong number can only be fixed by deleting the website.
                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        Text {
                            text: L.wd_counter + " " + root.analytics-counter;
                            font-size: Theme.text-xs;
                            color: Theme.text-faint;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        FlatButton {
                            text: L.action_disconnect;
                            clicked => { root.disconnect-analytics(); }
                        }
                    }

                    for chart in root.charts: Chart { data: chart; }

                    if root.top-pages.length > 0: Card {
                        title: L.wd_top_pages;
                        for page in root.top-pages: HorizontalLayout {
                            spacing: Theme.space-md;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            Text { text: page.url; font-size: Theme.text-sm; color: Theme.text; horizontal-stretch: 1; overflow: elide; }
                            Text { text: page.views; font-size: Theme.text-sm; color: Theme.text-muted; width: Layout.phone ? 56px : 100px; horizontal-alignment: right; }
                            Text { text: page.visitors; font-size: Theme.text-sm; color: Theme.text-muted; width: Layout.phone ? 56px : 100px; horizontal-alignment: right; }
                        }
                    }
                }
            }

            // Availability.
            if root.tab == 2: Card {
                title: L.tab_availability;
                DetailRow { label: L.label_status; value: root.website.status-label; }
                DetailRow { label: L.wd_http_status; value: root.website.http-status; }
                DetailRow { label: L.wd_response_time; value: root.website.response; }
                DetailRow { label: L.wd_uptime_24h; value: root.website.uptime-24h; }
            }

            // SSL.
            if root.tab == 3: Card {
                title: L.wd_tls_certificate;
                DetailRow { label: L.label_subject; value: root.website.ssl-subject; }
                DetailRow { label: L.label_issuer; value: root.website.ssl-issuer; }
                DetailRow { label: L.label_expires; value: root.website.ssl-expiry; }
            }

            // Events.
            if root.tab == 4: Card {
                title: L.tab_events;
                if root.events.length == 0: Text {
                    text: L.wd_no_events;
                    font-size: Theme.text-sm;
                    color: Theme.text-faint;
                }
                for event in root.events: HorizontalLayout {
                    spacing: Theme.space-sm;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    StatusBadge { status: event.severity; compact: true; width: 12px; }
                    Text { text: event.message; font-size: Theme.text-sm; color: Theme.text; horizontal-stretch: 1; overflow: elide; }
                    Text { text: event.when; font-size: Theme.text-xs; color: Theme.text-faint; }
                }
            }
        }
    }
}

// --- Analytics ---------------------------------------------------------------------

export component AnalyticsScreen inherits VerticalLayout {
    in property <[StatCard]> cards;
    in property <[ChartData]> charts;
    in property <[WebsiteCard]> websites;
    in property <[string]> periods;
    in property <[string]> metrics;
    in property <bool> configured;
    in property <string> updated;
    in-out property <int> period: 2;
    in-out property <int> metric: 0;

    callback period-changed(int);
    callback metric-changed(int);
    callback open-website(string);
    callback configure();

    padding: Layout.page-padding;
    spacing: Theme.space-md;

    HorizontalLayout {
        spacing: Theme.space-sm;
        Text {
            text: L.nav_analytics;
            font-size: Theme.text-lg;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.configured: Text {
            text: root.updated;
            font-size: Theme.text-xs;
            color: Theme.text-faint;
            vertical-alignment: center;
        }
        if root.configured: SegmentedControl {
            options: root.periods;
            selected <=> root.period;
            changed(index) => { root.period-changed(index); }
        }
    }

    if !root.configured: EmptyState {
        title: L.dash_no_analytics;
        detail: L.dash_no_analytics_detail;
        action-text: L.dash_connect_provider;
        action => { root.configure(); }
    }

    if root.configured: ScrollView {
        // Vertical only: see the note on the screens above.
        viewport-width: self.visible-width;
        VerticalLayout {
            spacing: Theme.space-md;

            TileGrid { cards: root.cards; }

            HorizontalLayout {
                alignment: start;
                SegmentedControl {
                    options: root.metrics;
                    selected <=> root.metric;
                    changed(index) => { root.metric-changed(index); }
                }
            }

            for chart in root.charts: Chart { data: chart; chart-height: 240px; }

            if root.websites.length > 0: Card {
                title: L.analytics_by_website;
                WebsiteGrid {
                    websites: root.websites;
                    open => { root.open-website(self.last-opened); }
                }
            }
        }
    }
}

// --- Alerts ------------------------------------------------------------------------

export component AlertsScreen inherits VerticalLayout {
    in property <[AlertRow]> open-incidents;
    in property <[AlertRow]> history;
    in property <[AlertRow]> rules;
    in-out property <int> tab: 0;

    callback acknowledge(string);
    callback toggle-rule(string);
    callback add-rule();

    property <[string]> tabs: [L.action_open, L.tab_history, L.tab_rules];

    padding: Layout.page-padding;
    spacing: Theme.space-md;

    HorizontalLayout {
        spacing: Theme.space-sm;
        Text {
            text: L.nav_alerts;
            font-size: Theme.text-lg;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.tab == 2: FlatButton {
            text: L.alerts_add_rule;
            primary: true;
            clicked => { root.add-rule(); }
        }
    }

    TabStrip {
        options: root.tabs;
        selected <=> root.tab;
    }

    ScrollView {
        // Vertical only: see the note on the screens above.
        viewport-width: self.visible-width;
        VerticalLayout {
            spacing: Theme.space-sm;

            if root.tab == 0 && root.open-incidents.length == 0: EmptyState {
                title: L.alerts_nothing_firing;
                detail: L.dash_all_healthy;
            }

            if root.tab == 0: VerticalLayout {
                spacing: Theme.space-sm;
                for incident in root.open-incidents: Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.status-color(incident.severity).with-alpha(0.45);
                min-height: 68px;

                HorizontalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-md;

                    StatusBadge {
                        status: incident.severity;
                        label: incident.severity-label;
                        compact: Layout.phone;
                        width: Layout.phone ? 14px : 96px;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: incident.title; font-size: Theme.text-sm; font-weight: 600; color: Theme.text; overflow: elide; }
                        Text { text: incident.detail; font-size: Theme.text-xs; color: Theme.text-muted; overflow: elide; }
                        Text { text: incident.subject + " · " + incident.opened; font-size: Theme.text-xs; color: Theme.text-faint; }
                    }
                    if !incident.acknowledged: FlatButton {
                        text: L.alerts_acknowledge;
                        clicked => { root.acknowledge(incident.id); }
                    }
                    if incident.acknowledged: Text {
                        text: L.alerts_acknowledged;
                        font-size: Theme.text-xs;
                        color: Theme.text-faint;
                        vertical-alignment: center;
                    }
                }
            }
            }

            if root.tab == 1: VerticalLayout {
                for incident in root.history: HorizontalLayout {
                padding: Theme.space-sm;
                spacing: Theme.space-md;
                StatusBadge { status: incident.severity; compact: true; width: 12px; }
                Text { text: incident.title; font-size: Theme.text-sm; color: Theme.text; horizontal-stretch: 1; overflow: elide; }
                if !Layout.phone: Text { text: incident.resolved ? L.alerts_resolved : L.alerts_open; font-size: Theme.text-xs; color: Theme.text-faint; width: 70px; }
                Text { text: incident.opened; font-size: Theme.text-xs; color: Theme.text-faint; }
            }
            }

            if root.tab == 2: VerticalLayout {
                spacing: Theme.space-sm;
                for rule in root.rules: Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-sm;
                min-height: 56px;

                HorizontalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-md;

                    StatusBadge {
                        status: rule.severity;
                        label: rule.severity-label;
                        compact: Layout.phone;
                        width: Layout.phone ? 14px : 96px;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text { text: rule.title; font-size: Theme.text-sm; font-weight: 600; color: Theme.text; overflow: elide; }
                        Text { text: rule.detail; font-size: Theme.text-xs; color: Theme.text-faint; overflow: elide; }
                    }
                    CheckBox {
                        checked: !rule.resolved;
                        toggled => { root.toggle-rule(rule.id); }
                    }
                }
            }
            }
        }
    }
}

// --- Settings ----------------------------------------------------------------------

export component SettingsScreen inherits ScrollView {
    // Never wider than the window.
    //
    // A `ScrollView` gives its content the content's own preferred width, and a `Text`
    // set to wrap still reports the width it would need on one line. So a single long
    // sentence made the whole page as wide as that sentence, and every card on it was
    // cut off at the same vertical line — which is what "nothing is adapted" actually
    // looked like. Pinning the viewport to the visible width makes the text wrap
    // instead.
    viewport-width: root.visible-width;

    in property <[string]> themes;
    in property <[string]> languages;
    in property <string> secret-backend;
    in property <bool> secret-backend-is-keyring;
    in property <string> screenshot-backend;
    in property <bool> screenshots-available;
    in property <string> database-path;
    in property <string> database-size;
    in property <string> log-path;
    in property <[string]> refresh-policies;

    in-out property <int> theme-index: 2;
    in-out property <int> language-index: 0;
    in-out property <int> screenshot-policy: 1;
    in-out property <bool> desktop-notifications: true;
    in-out property <bool> notification-sound: false;
    in-out property <bool> debug-mode: false;
    in-out property <string> webhook-url;
    in-out property <string> metrica-token;
    in property <bool> analytics-token-saved;
    in property <string> analytics-error;

    callback theme-changed(int);
    callback language-changed(int);
    callback save-analytics();
    callback save-notifications();
    callback screenshot-policy-changed(int);

    VerticalLayout {
        padding: Layout.page-padding;
        spacing: Theme.space-md;

        Text {
            text: L.nav_settings;
            font-size: Theme.text-lg;
            font-weight: 700;
            color: Theme.text;
        }

        Card {
            title: L.set_appearance;
            FormRow {
                label: L.set_theme;
                SegmentedControl {
                    options: root.themes;
                    selected <=> root.theme-index;
                    changed(index) => { root.theme-changed(index); }
                }
            }

            FormRow {
                label: L.set_language;
                SegmentedControl {
                    // Each language is named in itself, so it can be recognised without
                    // first understanding the current one.
                    options: root.languages;
                    selected <=> root.language-index;
                    changed(index) => { root.language-changed(index); }
                }
            }
        }

        Card {
            title: L.nav_analytics;
            subtitle: "Yandex.Metrica";

            Text {
                // Says where counters actually go, because the obvious place to look for
                // them is here.
                text: L.set_analytics_hint;
                font-size: Theme.text-sm;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            FormRow {
                label: L.set_oauth_token;
                LineEdit {
                    placeholder-text: L.set_token_hint;
                    // The token is never echoed back into this field once saved.
                    input-type: password;
                    text <=> root.metrica-token;
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                spacing: Theme.space-md;

                // Saving used to be silent whatever happened, so an empty token looked
                // exactly like a successful save.
                if root.analytics-error != "": Text {
                    text: root.analytics-error;
                    font-size: Theme.text-sm;
                    color: Theme.status-critical;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                if root.analytics-error == "" && root.analytics-token-saved: Text {
                    text: L.set_token_stored;
                    font-size: Theme.text-sm;
                    color: Theme.status-healthy;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                FlatButton {
                    text: L.action_save;
                    primary: true;
                    clicked => { root.save-analytics(); }
                }
            }
        }

        Card {
            title: L.set_notifications;

            CheckBox {
                text: L.set_desktop_notifications;
                checked <=> root.desktop-notifications;
            }
            CheckBox {
                text: L.set_play_sound;
                checked <=> root.notification-sound;
            }
            FormRow {
                label: L.set_webhook_url;
                LineEdit {
                    placeholder-text: L.dlg_ph_webhook;
                    text <=> root.webhook-url;
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                alignment: end;
                FlatButton {
                    text: L.action_save;
                    primary: true;
                    clicked => { root.save-notifications(); }
                }
            }
        }

        Card {
            title: L.tab_screenshot;
            subtitle: root.screenshot-backend;

            if !root.screenshots-available: Text {
                text: L.set_no_browser;
                font-size: Theme.text-xs;
                color: Theme.status-warning;
                wrap: word-wrap;
            }

            FormRow {
                label: L.action_refresh;
                SegmentedControl {
                    options: root.refresh-policies;
                    selected <=> root.screenshot-policy;
                    changed(index) => { root.screenshot-policy-changed(index); }
                }
            }
        }

        Card {
            title: L.set_credential_storage;

            DetailRow { label: L.set_backend; value: root.secret-backend; }
            // The user must never have to guess whether their SSH password is in the
            // system keychain or in a file.
            if !root.secret-backend-is-keyring: Text {
                text: L.set_encrypted_file_warning;
                font-size: Theme.text-xs;
                color: Theme.status-warning;
                wrap: word-wrap;
            }
        }

        Card {
            title: L.set_storage_diagnostics;
            DetailRow { label: L.set_database; value: root.database-path; }
            DetailRow { label: L.label_size; value: root.database-size; }
            DetailRow { label: L.set_logs; value: root.log-path; }
            CheckBox {
                text: L.set_debug_mode;
                checked <=> root.debug-mode;
            }
        }
    }
}

// --- Files ---------------------------------------------------------------------------

// Browsing and editing files on one server.
//
// The only screen that changes anything on a machine, which shapes three of its
// decisions. Deletion is armed per row and asks in place rather than in a modal, because
// a confirmation you have to read beats one you dismiss by reflex. A file that arrived
// truncated cannot be saved at all — saving the first megabyte back would destroy the
// rest. And the path is always visible, because "which folder am I in" is the question
// every mistake with a file browser starts with.
export component FilesScreen inherits VerticalLayout {
    in property <string> server-name;
    in property <string> path;
    in property <[FileEntry]> entries;
    in property <[SiteFolder]> site-folders;
    in property <bool> busy;
    in property <string> error;

    // The open file. An empty path means the listing is showing instead.
    in property <string> file-path;
    in property <string> file-info;
    in property <bool> file-truncated;
    /// `text`, `image` or `binary` — decided from the bytes that arrived, never from the
    /// file's name.
    in property <string> file-kind;
    in property <image> file-image;
    in property <bool> file-has-image;
    /// What to say when there is nothing to show: too large, or not a picture after all.
    in property <string> file-message;
    // `in-out` because the editor writes into it as the user types; the saved copy beside
    // it is what makes "has this changed" answerable without asking the server.
    in-out property <string> file-text;
    in property <string> file-saved-text;

    callback back();
    callback navigate(string);
    callback open-entry(string, bool);
    callback save-file(string);
    callback close-file();
    callback delete-entry(string);
    callback create-entry(string, bool);
    callback refresh();

    // Which row is asking to be confirmed, by name. One at a time, and cleared by any
    // navigation, so a confirmation cannot outlive the folder it was armed in.
    property <string> confirming: "";
    property <bool> creating: false;
    property <bool> creating-folder: true;
    property <string> new-name: "";

    property <bool> dirty: root.file-text != root.file-saved-text;

    padding: Layout.page-padding;
    spacing: Theme.space-md;

    // --- header ---
    HorizontalLayout {
        spacing: Theme.space-sm;

        FlatButton {
            text: L.action_back;
            clicked => {
                if (root.file-path != "") {
                    root.close-file();
                } else {
                    root.back();
                }
            }
        }
        VerticalLayout {
            spacing: 1px;
            Text {
                text: root.file-path != "" ? root.file-path : L.files_title;
                font-size: Theme.text-lg;
                font-weight: 700;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: root.file-path != "" ? root.file-info : root.server-name;
                font-size: Theme.text-xs;
                color: Theme.text-faint;
            }
        }
        Rectangle { horizontal-stretch: 1; }

        if root.file-kind == "text" && !root.file-truncated: FlatButton {
            text: root.dirty ? L.action_save : L.files_saved;
            primary: root.dirty;
            enabled: root.dirty && !root.busy;
            clicked => { root.save-file(root.file-text); }
        }
        if root.file-path == "": FlatButton {
            text: L.action_refresh;
            enabled: !root.busy;
            clicked => { root.confirming = ""; root.refresh(); }
        }
    }

    if root.error != "": Rectangle {
        background: Theme.status-critical.with-alpha(0.12);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.status-critical.with-alpha(0.4);
        VerticalLayout {
            padding: Theme.space-sm;
            Text {
                text: root.error;
                font-size: Theme.text-sm;
                color: Theme.status-critical;
                wrap: word-wrap;
            }
        }
    }

    // --- editor ---
    if root.file-kind == "text": VerticalLayout {
        spacing: Theme.space-sm;
        vertical-stretch: 1;

        if root.file-truncated: Rectangle {
            background: Theme.status-warning.with-alpha(0.12);
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.status-warning.with-alpha(0.4);
            VerticalLayout {
                padding: Theme.space-sm;
                Text {
                    text: L.files_truncated;
                    font-size: Theme.text-sm;
                    color: Theme.status-warning;
                    wrap: word-wrap;
                }
            }
        }

        if root.dirty: Text {
            text: L.files_unsaved;
            font-size: Theme.text-xs;
            color: Theme.status-warning;
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface-raised;
            clip: true;

            VerticalLayout {
                padding: 1px;
                TextEdit {
                    text <=> root.file-text;
                    // A truncated file is shown so it can be read, and locked so it
                    // cannot be saved back over the whole of itself.
                    read-only: root.file-truncated;
                    wrap: no-wrap;
                }
            }
        }
    }

    // --- image preview ---
    if root.file-kind == "image": VerticalLayout {
        spacing: Theme.space-sm;
        vertical-stretch: 1;

        if root.file-has-image: Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border;
            // A neutral ground rather than the surface colour: a PNG with transparency
            // shown on the theme background reads as part of the interface.
            background: Theme.dark ? #1a1a1a : #f0f0f0;
            clip: true;

            Image {
                source: root.file-image;
                // Never enlarged past its own size: an upscaled favicon is a blurry
                // rectangle, and its actual size is the useful thing to see.
                image-fit: contain;
                width: parent.width - Theme.space-md * 2;
                height: parent.height - Theme.space-md * 2;
                x: Theme.space-md;
                y: Theme.space-md;
            }
        }

        if !root.file-has-image: EmptyState {
            title: root.file-message;
            vertical-stretch: 1;
        }
    }

    // --- anything else ---
    if root.file-kind == "binary": EmptyState {
        title: L.files_binary;
        detail: root.file-message;
        vertical-stretch: 1;
    }

    // --- listing ---
    if root.file-path == "": VerticalLayout {
        spacing: Theme.space-sm;
        vertical-stretch: 1;

        // The site folders, when the server's own configuration named any.
        if root.site-folders.length > 0: VerticalLayout {
            spacing: Theme.space-xs;
            Text {
                text: L.files_site_folders;
                font-size: Theme.text-xs;
                font-weight: 600;
                color: Theme.text-faint;
            }
            HorizontalLayout {
                spacing: Theme.space-xs;
                for folder in root.site-folders: FlatButton {
                    text: folder.label;
                    primary: folder.path == root.path;
                    clicked => { root.confirming = ""; root.navigate(folder.path); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Where we are, and the way out of it.
        if Layout.phone: Rectangle {
            height: 30px;
            border-radius: Theme.radius-sm;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding-left: Theme.space-sm;
                padding-right: Theme.space-sm;
                Text {
                    text: root.path;
                    font-size: Theme.text-sm;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-sm;

            FlatButton {
                text: L.files_up;
                enabled: root.path != "/";
                clicked => { root.confirming = ""; root.navigate(root.path + "/.."); }
            }
            if !Layout.phone: Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.radius-sm;
                background: Theme.surface-raised;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding-left: Theme.space-sm;
                    padding-right: Theme.space-sm;
                    Text {
                        text: root.path;
                        font-size: Theme.text-sm;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            if Layout.phone: Rectangle { horizontal-stretch: 1; }
            FlatButton {
                text: L.files_new_folder;
                enabled: !root.busy;
                clicked => {
                    root.creating = true;
                    root.creating-folder = true;
                    root.new-name = "";
                }
            }
            FlatButton {
                text: L.files_new_file;
                enabled: !root.busy;
                clicked => {
                    root.creating = true;
                    root.creating-folder = false;
                    root.new-name = "";
                }
            }
        }

        if root.creating: HorizontalLayout {
            spacing: Theme.space-sm;

            LineEdit {
                placeholder-text: root.creating-folder ? L.files_folder_name : L.files_file_name;
                text <=> root.new-name;
                accepted => {
                    if (root.new-name != "") {
                        root.create-entry(root.new-name, root.creating-folder);
                        root.creating = false;
                    }
                }
            }
            FlatButton {
                text: L.action_add;
                primary: true;
                enabled: root.new-name != "";
                clicked => {
                    root.create-entry(root.new-name, root.creating-folder);
                    root.creating = false;
                }
            }
            FlatButton {
                text: L.action_cancel;
                clicked => { root.creating = false; }
            }
        }

        if root.entries.length == 0 && !root.busy: EmptyState {
            title: L.files_empty;
            vertical-stretch: 1;
        }

        if root.entries.length > 0: ScrollView {
            // Vertical only: see the note on the screens above.
            viewport-width: self.visible-width;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 1px;

                for entry in root.entries: Rectangle {
                    height: row.preferred-height;
                    background: touch.has-hover ? Theme.surface-hover : Colors.transparent;
                    border-radius: Theme.radius-sm;

                    touch := TouchArea {
                        mouse-cursor: entry.is-directory || entry.can-open
                            ? MouseCursor.pointer
                            : MouseCursor.default;
                        clicked => {
                            root.confirming = "";
                            if (entry.is-directory || entry.can-open) {
                                root.open-entry(entry.name, entry.is-directory);
                            }
                        }
                    }

                    row := HorizontalLayout {
                        padding: Theme.space-sm;
                        spacing: Theme.space-sm;

                        Text {
                            text: entry.is-directory ? "›" : (entry.kind == "symlink" ? "@" : "·");
                            font-size: Theme.text-sm;
                            color: Theme.text-faint;
                            vertical-alignment: center;
                            width: 12px;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text {
                                text: entry.name;
                                font-size: Theme.text-sm;
                                color: Theme.text;
                                overflow: elide;
                            }
                            if entry.detail != "": Text {
                                text: entry.detail;
                                font-size: Theme.text-xs;
                                color: Theme.text-faint;
                                overflow: elide;
                            }
                        }

                        if !Layout.compact: Text {
                            text: entry.mode + "  " + entry.owner;
                            font-size: Theme.text-xs;
                            color: Theme.text-faint;
                            vertical-alignment: center;
                        }
                        if !Layout.compact: Text {
                            text: entry.modified;
                            font-size: Theme.text-xs;
                            color: Theme.text-faint;
                            vertical-alignment: center;
                            width: 130px;
                            horizontal-alignment: right;
                        }
                        Text {
                            text: entry.size;
                            font-size: Theme.text-xs;
                            color: Theme.text-faint;
                            vertical-alignment: center;
                            width: Layout.phone ? 58px : 80px;
                            horizontal-alignment: right;
                        }

                        // Armed in place rather than in a modal: the name being deleted
                        // stays on screen beside the question.
                        if root.confirming != entry.name: FlatButton {
                            text: L.files_delete_title;
                            enabled: !root.busy;
                            clicked => { root.confirming = entry.name; }
                        }
                        if root.confirming == entry.name: FlatButton {
                            text: L.action_cancel;
                            clicked => { root.confirming = ""; }
                        }
                        if root.confirming == entry.name: FlatButton {
                            text: L.files_delete_title;
                            primary: true;
                            enabled: !root.busy;
                            clicked => {
                                root.confirming = "";
                                root.delete-entry(entry.name);
                            }
                        }
                    }
                }
            }
        }

        if root.confirming != "": Text {
            text: L.files_delete_folder_note;
            font-size: Theme.text-xs;
            color: Theme.text-faint;
            wrap: word-wrap;
        }
    }
}
