// Reusable pieces. Nothing here knows what a server or a website is.

import { ScrollView } from "std-widgets.slint";
import { Theme, Layout } from "theme.slint";
import { L } from "strings.slint";
import { StatCard, ChartData } from "models.slint";

// A coloured dot plus a label.
export component StatusBadge inherits HorizontalLayout {
    in property <string> status;
    in property <string> label;
    in property <bool> compact: false;

    spacing: Theme.space-xs + 2px;
    alignment: start;

    Rectangle {
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        background: Theme.status-color(root.status);
        y: (parent.height - self.height) / 2;
    }

    if !root.compact: Text {
        text: root.label;
        font-size: Theme.text-sm;
        color: Theme.text-muted;
        vertical-alignment: center;
    }
}

// Navigation icons, drawn rather than typed.
//
// These used to be characters — ◧ ▤ ◈ ◐ △ ⚙ — which works on a desktop and does not work
// on a phone: two of the six came out as empty boxes on the test device. A font is not
// obliged to carry the Geometric Shapes block, what a given Android build ships is the
// vendor's choice, and there is no way to ask at runtime whether a glyph exists. Shapes
// have no such dependency, so they cannot go missing.
export component NavIcon inherits Rectangle {
    in property <string> kind;
    in property <color> tint;
    in property <length> size: 18px;

    width: root.size;
    height: root.size;

    // Dashboard: four panels.
    if root.kind == "dashboard": Rectangle {
        Rectangle {
            x: 0; y: 0;
            width: parent.width * 0.42; height: parent.height * 0.42;
            border-radius: 2px; background: root.tint;
        }
        Rectangle {
            x: parent.width * 0.58; y: 0;
            width: parent.width * 0.42; height: parent.height * 0.42;
            border-radius: 2px; background: root.tint;
        }
        Rectangle {
            x: 0; y: parent.height * 0.58;
            width: parent.width * 0.42; height: parent.height * 0.42;
            border-radius: 2px; background: root.tint;
        }
        Rectangle {
            x: parent.width * 0.58; y: parent.height * 0.58;
            width: parent.width * 0.42; height: parent.height * 0.42;
            border-radius: 2px; background: root.tint;
        }
    }

    // Servers: stacked units.
    if root.kind == "servers": Rectangle {
        Rectangle {
            x: 0; y: parent.height * 0.08;
            width: parent.width; height: parent.height * 0.22;
            border-radius: 2px; background: root.tint;
        }
        Rectangle {
            x: 0; y: parent.height * 0.39;
            width: parent.width; height: parent.height * 0.22;
            border-radius: 2px; background: root.tint;
        }
        Rectangle {
            x: 0; y: parent.height * 0.70;
            width: parent.width; height: parent.height * 0.22;
            border-radius: 2px; background: root.tint;
        }
    }

    // Websites: a globe.
    if root.kind == "websites": Rectangle {
        Rectangle {
            width: parent.width; height: parent.height;
            border-radius: parent.width / 2;
            border-width: 1.6px; border-color: root.tint;
            background: transparent;
        }
        Rectangle {
            x: parent.width * 0.34; y: 0;
            width: parent.width * 0.32; height: parent.height;
            border-radius: parent.width * 0.16;
            border-width: 1.6px; border-color: root.tint;
            background: transparent;
        }
        Rectangle {
            x: 0; y: (parent.height - 1.6px) / 2;
            width: parent.width; height: 1.6px;
            background: root.tint;
        }
    }

    // Analytics: a bar chart.
    if root.kind == "analytics": Rectangle {
        Rectangle {
            x: 0; y: parent.height * 0.45;
            width: parent.width * 0.24; height: parent.height * 0.55;
            border-radius: 1px; background: root.tint;
        }
        Rectangle {
            x: parent.width * 0.38; y: parent.height * 0.20;
            width: parent.width * 0.24; height: parent.height * 0.80;
            border-radius: 1px; background: root.tint;
        }
        Rectangle {
            x: parent.width * 0.76; y: 0;
            width: parent.width * 0.24; height: parent.height;
            border-radius: 1px; background: root.tint;
        }
    }

    // Alerts: a warning triangle.
    if root.kind == "alerts": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M 12 2 L 23 21 L 1 21 Z";
        fill: root.tint;
    }

    // Settings: sliders. A gear needs a path with teeth; two rows with a knob each says
    // the same thing and survives being drawn 18 pixels wide.
    if root.kind == "settings": Rectangle {
        Rectangle {
            x: 0; y: parent.height * 0.28;
            width: parent.width; height: 1.8px;
            background: root.tint;
        }
        Rectangle {
            x: parent.width * 0.58; y: parent.height * 0.28 - 3px;
            width: 7.6px; height: 7.6px;
            border-radius: 3.8px; background: root.tint;
        }
        Rectangle {
            x: 0; y: parent.height * 0.70;
            width: parent.width; height: 1.8px;
            background: root.tint;
        }
        Rectangle {
            x: parent.width * 0.22; y: parent.height * 0.70 - 3px;
            width: 7.6px; height: 7.6px;
            border-radius: 3.8px; background: root.tint;
        }
    }
}

// The standard container. Everything sits in one of these.
export component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;

    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: Layout.card-padding;
        spacing: Theme.space-sm;

        if root.title != "": VerticalLayout {
            spacing: 2px;
            Text {
                text: root.title;
                font-size: Theme.text-sm;
                font-weight: 600;
                color: Theme.text-muted;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: Theme.text-xs;
                color: Theme.text-faint;
            }
        }

        @children
    }
}

// One headline number.
export component StatTile inherits Rectangle {
    in property <StatCard> data;

    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    min-height: 92px;

    VerticalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-xs;
        alignment: center;

        Text {
            text: root.data.label;
            font-size: Theme.text-xs;
            color: Theme.text-muted;
            // Uppercase in the label, not in the data: a hostname must never be shouted.
            letter-spacing: 0.6px;
        }
        Text {
            text: root.data.value;
            font-size: Theme.text-xl;
            font-weight: 700;
            // Untinted unless the value means something is wrong; colouring every number
            // would make colour meaningless.
            color: root.data.status == "" ? Theme.text : Theme.status-color(root.data.status);
            overflow: elide;
        }
        if root.data.detail != "": Text {
            text: root.data.detail;
            font-size: Theme.text-xs;
            color: Theme.text-faint;
            overflow: elide;
        }
    }
}

// Stat tiles, wrapped into rows.
//
// Four across is right on a monitor and unreadable on a phone. Slint has no wrapping flow
// layout, so the rows are laid out by hand — the same approach `WebsiteGrid` takes, for
// the same reason.
export component TileGrid inherits VerticalLayout {
    in property <[StatCard]> cards;

    spacing: Theme.space-md;
    vertical-stretch: 0;

    for row-index in ceil(root.cards.length / Layout.tile-columns): HorizontalLayout {
        spacing: Theme.space-md;

        for column in Layout.tile-columns: cell := VerticalLayout {
            // Named so the `if` below can reach it: Slint has no way to walk up from a
            // child to its parent's properties.
            property <int> index: row-index * Layout.tile-columns + column;
            property <bool> present: self.index < root.cards.length;

            horizontal-stretch: 1;

            // The last row is usually short. An absent cell still takes its share of the
            // width, so the tiles above it stay in their columns instead of stretching.
            if cell.present: StatTile {
                data: root.cards[min(cell.index, max(0, root.cards.length - 1))];
            }
        }
    }
}

// A labelled progress bar, used for CPU/RAM/disk in a row.
export component MeterBar inherits VerticalLayout {
    in property <string> label;
    // Negative means the value was not measured, drawn as an empty track, not a zero bar.
    in property <float> fraction: -1;
    in property <string> value;

    spacing: 3px;

    HorizontalLayout {
        Text {
            text: root.label;
            font-size: Theme.text-xs;
            color: Theme.text-faint;
        }
        Rectangle { }
        Text {
            text: root.value;
            font-size: Theme.text-xs;
            color: Theme.text-muted;
        }
    }

    Rectangle {
        height: 5px;
        border-radius: 2.5px;
        background: Theme.chart-grid;

        if root.fraction >= 0: Rectangle {
            x: 0;
            width: parent.width * min(1.0, max(0.0, root.fraction));
            height: parent.height;
            border-radius: parent.border-radius;
            // Colour by severity rather than by a gradient: a bar that is subtly redder
            // at 71% than at 69% tells nobody anything.
            background: root.fraction >= 0.9
                ? Theme.status-critical
                : (root.fraction >= 0.8 ? Theme.status-warning : Theme.status-healthy);
        }
    }
}

// A line chart. The geometry is computed in Rust; this only draws.
export component Chart inherits Rectangle {
    in property <ChartData> data;
    in property <length> chart-height: 180px;

    // The path coordinates were computed against this box, so it must match what
    // `chart::build` was given.
    property <length> plot-width: self.width - 56px;
    property <length> plot-height: root.chart-height - 28px;

    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    height: root.chart-height + 44px;

    VerticalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-sm;

        Text {
            text: root.data.title;
            font-size: Theme.text-sm;
            font-weight: 600;
            color: Theme.text-muted;
        }

        if !root.data.has-data: Rectangle {
            height: root.plot-height;
            Text {
                text: root.data.empty-message;
                font-size: Theme.text-sm;
                color: Theme.text-faint;
            }
        }

        if root.data.has-data: HorizontalLayout {
            spacing: Theme.space-sm;

            // Y axis.
            VerticalLayout {
                width: 48px;
                for label in root.data.y-labels: Text {
                    text: label;
                    font-size: Theme.text-xs;
                    color: Theme.text-faint;
                    horizontal-alignment: right;
                    vertical-alignment: top;
                }
            }

            VerticalLayout {
                spacing: 4px;

                Rectangle {
                    height: root.plot-height;
                    clip: true;

                    // Gridlines, one per y-axis label.
                    for label[index] in root.data.y-labels: Rectangle {
                        y: root.plot-height * index / max(1, root.data.y-labels.length - 1);
                        height: 1px;
                        background: Theme.chart-grid;
                    }

                    // The min/max band sits behind the line, so a spike is visible as
                    // spread rather than being averaged into invisibility.
                    if root.data.band != "": Path {
                        width: root.plot-width;
                        height: root.plot-height;
                        viewbox-width: root.plot-width / 1px;
                        viewbox-height: root.plot-height / 1px;
                        commands: root.data.band;
                        fill: Theme.chart-band;
                    }

                    Path {
                        width: root.plot-width;
                        height: root.plot-height;
                        viewbox-width: root.plot-width / 1px;
                        viewbox-height: root.plot-height / 1px;
                        commands: root.data.line;
                        stroke: Theme.chart-line;
                        stroke-width: 2px;
                    }
                }

                HorizontalLayout {
                    for label in root.data.x-labels: Text {
                        text: label;
                        font-size: Theme.text-xs;
                        color: Theme.text-faint;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

// A flat button that does not look like a 1998 dialog.
export component FlatButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    border-radius: Theme.radius-sm;
    background: root.primary
        ? (touch.has-hover ? Theme.accent.darker(0.1) : Theme.accent)
        : (touch.has-hover ? Theme.surface-hover : Theme.surface-raised);
    border-width: root.primary ? 0 : 1px;
    border-color: Theme.border;
    opacity: root.enabled ? 1.0 : 0.45;

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        Text {
            text: root.text;
            font-size: Theme.text-sm;
            font-weight: 600;
            color: root.primary ? #ffffff : Theme.text;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A row of mutually exclusive options — time ranges, analytics periods.
export component SegmentedControl inherits HorizontalLayout {
    in property <[string]> options;
    in-out property <int> selected: 0;
    callback changed(int);

    spacing: 2px;

    for option[index] in root.options: Rectangle {
        border-radius: Theme.radius-sm;
        background: index == root.selected
            ? Theme.accent-soft
            : (segment.has-hover ? Theme.surface-hover : transparent);

        HorizontalLayout {
            padding: Theme.space-sm;
            padding-top: 6px;
            padding-bottom: 6px;
            Text {
                text: option;
                font-size: Theme.text-xs;
                font-weight: index == root.selected ? 700 : 500;
                color: index == root.selected ? Theme.accent : Theme.text-muted;
                vertical-alignment: center;
            }
        }

        segment := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.selected = index;
                root.changed(index);
            }
        }
    }
}

// A row of tabs that stays reachable on a narrow screen.
//
// The server detail page has seven tabs. Side by side they need about 420px; a phone has
// 310. Shrinking them until they fit makes the labels unreadable and the targets too
// small to hit, so instead the strip scrolls sideways — which is what a phone user
// expects a tab bar to do.
export component TabStrip inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected: 0;
    callback changed(int);

    height: 34px;

    if !Layout.phone: SegmentedControl {
        options: root.options;
        selected <=> root.selected;
        changed(index) => { root.changed(index); }
    }

    if Layout.phone: ScrollView {
        // The viewport is as wide as the tabs actually need. Left at its default it
        // matches the view, the tabs are squeezed into it, and there is nothing to
        // scroll — the failure then looks exactly like the overflow it was meant to fix.
        viewport-width: max(self.width, strip.preferred-width);
        viewport-height: self.height;

        strip := SegmentedControl {
            options: root.options;
            selected <=> root.selected;
            changed(index) => { root.changed(index); }
        }
    }
}

// Shown wherever a list is legitimately empty.
//
// A distinct component because "nothing here yet" and "we could not load this" must not
// look the same, and an empty table with no explanation looks like a bug.
export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> detail;
    in property <string> action-text;
    callback action();

    alignment: center;
    spacing: Theme.space-sm;
    padding: Theme.space-xl;

    Text {
        text: root.title;
        font-size: Theme.text-base;
        font-weight: 600;
        color: Theme.text-muted;
        horizontal-alignment: center;
        // The detail below always wrapped; the title did not, so "No analytics provider
        // is connected" ran off the side of a phone.
        wrap: word-wrap;
    }
    Text {
        text: root.detail;
        font-size: Theme.text-sm;
        color: Theme.text-faint;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.action-text != "": HorizontalLayout {
        alignment: center;
        FlatButton {
            text: root.action-text;
            primary: true;
            clicked => { root.action(); }
        }
    }
}

// A key/value line, used throughout the detail pages.
//
// Two shapes, one component. Side by side where there is room; label above value where
// there is not — 132px of label out of ~310px of usable phone width leaves the value
// with less room than the word describing it.
export component DetailRow inherits VerticalLayout {
    in property <string> label;
    in property <string> value;

    spacing: 2px;
    // A nested layout stretches by default; a row of text should take the height its
    // text needs and no more.
    vertical-stretch: 0;

    if Layout.phone: Text {
        text: root.label;
        font-size: Theme.text-xs;
        color: Theme.text-faint;
    }

    HorizontalLayout {
        spacing: Theme.space-md;

        if !Layout.phone: Text {
            text: root.label;
            font-size: Theme.text-sm;
            color: Theme.text-faint;
            width: 132px;
        }
        Text {
            text: root.value;
            font-size: Theme.text-sm;
            color: Theme.text;
            horizontal-stretch: 1;
            // Wrapping beats eliding on a phone: a hostname or a path cut short is
            // exactly the value someone came to this row to read.
            wrap: Layout.phone ? word-wrap : no-wrap;
            overflow: Layout.phone ? clip : elide;
        }
    }
}

// A form row: a label and whatever control belongs to it.
//
// The same rule as `DetailRow`, and the reason both exist as components at all. Every
// screen used to write this by hand as a `HorizontalLayout` with a hard-coded label
// width, so making the layout responsive meant editing every screen — and missing one
// meant a field off the edge of the screen with nothing to hint at it.
export component FormRow inherits VerticalLayout {
    in property <string> label;
    // Where the label sits beside a tall control — a key field, a block of text — it
    // should align with the top of it rather than float in the middle.
    in property <bool> align-top: false;

    spacing: Theme.space-xs;
    vertical-stretch: 0;

    if Layout.phone && root.label != "": Text {
        text: root.label;
        font-size: Theme.text-sm;
        color: Theme.text-muted;
    }

    HorizontalLayout {
        spacing: Theme.space-md;

        if !Layout.phone && root.label != "": Text {
            text: root.label;
            font-size: Theme.text-sm;
            color: Theme.text-muted;
            width: 132px;
            vertical-alignment: root.align-top ? top : center;
        }

        @children
    }
}
